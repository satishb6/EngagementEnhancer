# ---- core ----
# LITE MODE (default): leave DATABASE_URL/REDIS_URL as-is → SQLite file +
# background loops inside the API. Zero infrastructure, zero cost.
# SCALE MODE: set the postgres + redis URLs below and EMBEDDED_WORKER=0.
WIRE_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./wire.db
#DATABASE_URL=postgresql+asyncpg://wire:wire@localhost:5432/wire_dev
REDIS_URL=
#REDIS_URL=redis://localhost:6379/0
EMBEDDED_WORKER=1
SECRET_KEY=change-me-64-random-chars
API_BASE_URL=http://localhost:8000

# ---- provider keys — ALL OPTIONAL ----
# With none set, the app runs in honest zero-key Demo mode, and users can
# paste their own keys in Studio → Engine (kept in their browser only).
# Free tiers to start with:
GROQ_API_KEY=              # console.groq.com — FREE, fast; best first key
GOOGLE_API_KEY=            # aistudio.google.com — FREE text + embeddings
OPENROUTER_API_KEY=        # openrouter.ai — many :free models
# Paid options:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
FAL_KEY=                   # real images + video (else SVG demo placeholders)
DEEPGRAM_API_KEY=          # voice takes

# ---- ingestion ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wire/0.1 by yourhandle
YOUTUBE_API_KEY=
NEWSDATA_API_KEY=          # or GNEWS_API_KEY / MEDIASTACK_API_KEY
NEWS_API_VENDOR=newsdata   # newsdata | gnews | mediastack

# ---- billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=          # price id for the pro subscription
STRIPE_PRICE_BYOK=         # price id for the byok subscription

# ---- publishing ----
PUBLISH_VENDOR=ayrshare    # ayrshare | postiz | bundlesocial
AYRSHARE_API_KEY=
PUBLISH_WEBHOOK_SECRET=

# ---- BYOK key encryption ----
# 32-byte urlsafe base64 key for envelope encryption (Fernet). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_MASTER_KEY=

# ---- storage (S3-compatible) ----
S3_ENDPOINT_URL=
S3_BUCKET=wire-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- local GPU mode ----
LOCAL_MODE=0
OLLAMA_BASE_URL=http://localhost:11434
COMFYUI_BASE_URL=http://localhost:8188

# ---- web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
