# Copy to .env.production and fill in. NEVER commit .env.production.

# ---- domains (point DNS A records at your server first) ----
WIRE_DOMAIN=app.yourdomain.com
WIRE_API_DOMAIN=api.yourdomain.com

# ---- database ----
POSTGRES_USER=wire
POSTGRES_PASSWORD=            # long random string: openssl rand -hex 24
POSTGRES_DB=wire

# ---- core ----
WIRE_ENV=production
SECRET_KEY=                   # openssl rand -hex 32
API_BASE_URL=https://api.yourdomain.com

# ---- provider keys (platform cloud tier) ----
ANTHROPIC_API_KEY=            # console.anthropic.com — briefings + composition
OPENAI_API_KEY=               # platform.openai.com — embeddings
FAL_KEY=                      # fal.ai — images + video
DEEPGRAM_API_KEY=             # deepgram.com — voice takes (optional at launch)
GOOGLE_API_KEY=               # optional fallback

# ---- ingestion ----
REDDIT_CLIENT_ID=             # reddit.com/prefs/apps (script app)
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wire/0.1 by yourhandle
YOUTUBE_API_KEY=              # console.cloud.google.com — YouTube Data API v3
NEWSDATA_API_KEY=             # newsdata.io free tier to start
NEWS_API_VENDOR=newsdata

# ---- billing (needed before charging; app runs free-tier-only without) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BYOK=

# ---- BYOK key encryption (REQUIRED) ----
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_MASTER_KEY=

# ---- publishing (needed for pro auto-posting; clipboard works without) ----
PUBLISH_VENDOR=ayrshare
AYRSHARE_API_KEY=
PUBLISH_WEBHOOK_SECRET=       # openssl rand -hex 24

# ---- artifact storage (S3-compatible; Cloudflare R2 recommended) ----
S3_ENDPOINT_URL=
S3_BUCKET=wire-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
